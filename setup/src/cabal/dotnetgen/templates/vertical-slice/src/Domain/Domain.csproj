<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zero external dependencies by design (csharp.md). Adding a PackageReference here
       is a template violation, not a preference - the domain layer stays pure. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
