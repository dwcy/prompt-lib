{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cabal-evals/comparison.schema.json",
  "title": "Per-task pairwise judge artifact (comparison.json)",
  "type": "object",
  "required": ["schema_version", "run_id", "task_id", "baseline_config", "candidate_config", "judge_model", "pairs"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "baseline_config": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "candidate_config": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "judge_model": { "type": "string", "minLength": 1 },
    "rubrics": { "type": "array", "items": { "type": "string" } },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pair_verdict" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pair_verdict": {
      "type": "object",
      "required": ["repetition", "winner", "confidence", "order_agreement", "criteria", "truncated"],
      "properties": {
        "repetition": { "type": "integer", "minimum": 1 },
        "winner": { "enum": ["baseline", "candidate", "tie", "judge_error"] },
        "confidence": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ]
        },
        "order_agreement": { "type": "boolean" },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "favored", "note"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "favored": { "enum": ["baseline", "candidate", "tie"] },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "truncated": { "type": "boolean" },
        "error_detail": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "order_agreement": { "const": false } } },
          "then": { "properties": { "winner": { "enum": ["tie", "judge_error"] } } }
        }
      ]
    }
  }
}
