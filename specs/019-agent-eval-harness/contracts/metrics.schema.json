{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cabal-evals/metrics.schema.json",
  "title": "Per-run metrics artifact (metrics.json)",
  "type": "object",
  "required": [
    "schema_version", "run_id", "task_id", "config_name", "repetition", "adapter",
    "status", "failure_reason", "agent", "diff", "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "config_name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "repetition": { "type": "integer", "minimum": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "failed"] },
    "failure_reason": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["agent_timeout", "agent_crash", "worktree_error", "check_timeout", "profile_error", "adapter_unavailable"] }
      ]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "agent": {
      "type": "object",
      "required": ["tool_calls_total", "tool_calls_by_name", "num_turns", "input_tokens", "output_tokens", "cache_read_tokens", "cost_usd", "wall_seconds"],
      "properties": {
        "tool_calls_total": { "type": ["integer", "null"], "minimum": 0 },
        "tool_calls_by_name": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "num_turns": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "wall_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["files_changed", "insertions", "deletions", "unrequested_changes_count", "unrequested_files", "empty_diff"],
      "properties": {
        "files_changed": { "type": "integer", "minimum": 0 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "unrequested_changes_count": { "type": ["integer", "null"], "minimum": 0 },
        "unrequested_files": { "type": ["array", "null"], "items": { "type": "string" } },
        "empty_diff": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check_result" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "check_result": {
      "type": "object",
      "required": ["kind", "cmd", "status", "exit_code", "duration_seconds"],
      "properties": {
        "kind": { "enum": ["test", "build", "lint", "custom"] },
        "cmd": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "status": { "enum": ["passed", "failed", "timeout", "error", "skipped"] },
        "exit_code": { "type": ["integer", "null"] },
        "passed_count": { "type": ["integer", "null"], "minimum": 0 },
        "failed_count": { "type": ["integer", "null"], "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
