{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline capability for the main Cabal window, plus execute permission for the dev-mode backend launch and the production cabal-backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "uv",
          "cmd": "uv",
          "args": ["run", "cabal-backend"]
        },
        {
          "name": "cabal-backend",
          "cmd": "cabal-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
