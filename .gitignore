# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
.env.*
!.env.example
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# uv
# uv.lock SHOULD be committed; nothing to ignore here

# Build / dist
dist/
build/
# Exception: the setup/build/ tree holds the PyInstaller driver, .spec, README,
# and build.cmd — those ARE source and must ship. Only the PyInstaller output
# directories (dist/, intermediate build/) inside setup/build/ stay ignored.
!setup/build/
setup/build/dist/
setup/build/build/

# Node / frontend (apps/cabal-desktop)
node_modules/
apps/cabal-desktop/dist/
apps/cabal-desktop/coverage/
apps/cabal-desktop/playwright-report/
apps/cabal-desktop/test-results/
*.tsbuildinfo

# Rust / Tauri (apps/cabal-desktop/src-tauri)
apps/cabal-desktop/src-tauri/target/
apps/cabal-desktop/src-tauri/gen/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Obsidian local workspace state
.obsidian/workspace.json

# OS
.DS_Store
Thumbs.db

# Local-only Claude state (project skills/commands ARE committed; only ephemera here)
.claude/settings.local.json
.claude/worktrees/
.Codex/

# Spec-kit local install state (declared config in .specify/extensions.yml IS committed)
.specify/extensions/.registry

# Generated OKF catalog — regenerate on demand with `python -m cabal.okf export`.
# The hand-written docs/okf/README.md stays tracked; only the generated bundle is ignored.
docs/okf/prompt-lib/

.cabal/

.mcp.json

# .NET build output - the dotnetgen templates ship .cs/.csproj sources; builds are artifacts.
bin/
obj/
*.user
*.suo

# Per-solution dotnetgen state: map cache, run records, the pending approval token. Written into
# every solution the pipeline touches, this repo included. Run records carry model names and usage.
.dotnetgen/

# Playwright MCP output. A page snapshot dumps everything VISIBLE ON SCREEN into the working
# directory, so these files routinely capture absolute paths, container names and other machine
# state that has nothing to do with this repo. Never commit them - this repo is public.
.playwright-mcp/

# Loose local scratch: screenshots and archives dropped in the repo root while working.
/*.zip
/port*.png

# Generated by the onboarding skill from personal usage telemetry, and titled with the org name.
# It's a shareable artifact, not repo source, and this repo is public.
/ONBOARDING.md

# Agent eval harness output — tasks/rubrics/configs under evals/ ARE committed; results are runs.
evals/results/
